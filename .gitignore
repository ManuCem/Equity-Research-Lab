# Earnings-call transcripts are third-party copies (not SEC documents): keep them local, never publish.
# The pattern covers every company folder that follows the <Company>/filings/ convention.
*/filings/*transcript*

# Screenshots from tools/check_phone.py: proof that a page renders, not part of the deliverable
tools/shots/

# Python and Excel leftovers
__pycache__/
*.pyc
~$*.xlsx

# Course workbooks used as a style reference: local only, never published
finances-examples/

# Local build helper shared by the company scripts: code stays on this machine
tools/course_layout.py
